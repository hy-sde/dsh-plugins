{
  "name": "@hy-sde-org/dsh-tool-openwiki",
  "version": "0.2.1-alpha.2",
  "description": "OpenWiki lifecycle tools (openwiki_begin/submit_plan/next_page/submit_page/finish) over the in-process engine @hy-sde-org/dsh-openwiki, plus an openwiki:tools prompt section wiring codebase-memory tools as structural discovery — no external CLI.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "examples/agent-preset/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run clean && pnpm run build"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hy-sde/dsh-openwiki.git",
    "directory": "packages/tool-openwiki"
  },
  "license": "MIT",
  "dependencies": {
    "@hy-sde-org/dsh-openwiki": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-util-values": "^0.2.1-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-alpha.2",
    "@hy-sde-org/dsh-openwiki": "workspace:^",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "@deepseek-ai/dsh-util-values": "^0.2.1-alpha.2"
  },
  "keywords": [
    "deepseek",
    "agent",
    "harness",
    "dsh-plugin",
    "openwiki",
    "grounded-claims",
    "wiki"
  ],
  "homepage": "https://github.com/hy-sde/dsh-openwiki#readme",
  "bugs": {
    "url": "https://github.com/hy-sde/dsh-openwiki/issues"
  }
}
