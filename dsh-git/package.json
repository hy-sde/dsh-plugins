{
  "name": "dsh-git",
  "version": "0.1.2-rc.1",
  "private": true,
  "description": "Standalone public packages: @hy-sde-org/dsh-git (the host ctx.git service) and @hy-sde-org/dsh-tool-git (the commit/commit_apply/review/worktree tools) for DeepSeek Harness — a port of oh-my-pi's agentic git commit + review.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "pack:all": "pnpm -r --filter \"./packages/*\" --filter \"./packages/*/*\" pack",
    "release:check": "bash scripts/release-public.sh --check",
    "release:publish": "bash scripts/release-public.sh --publish"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "deepseek",
    "agent",
    "harness",
    "dsh-plugin",
    "git",
    "commit",
    "review"
  ]
}
