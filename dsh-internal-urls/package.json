{
  "name": "dsh-internal-urls",
  "version": "0.1.2-rc.1",
  "private": true,
  "description": "Standalone public packages: @hy-sde-org/dsh-internal-urls (the FS-shaped internal-URL resolver registry), @hy-sde-org/dsh-tool-fs-internal-urls and @hy-sde-org/dsh-tool-fs-search-internal-urls (the read/write/grep routing surface that makes conflict://, pr://, issue:// work on stock DeepSeek Harness).",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "check": "pnpm -r --filter './packages/*' check",
    "test": "pnpm -r --filter './packages/*' test",
    "pack:all": "pnpm -r --filter './packages/*' pack",
    "release:check": "bash scripts/release-public.sh --check",
    "release:publish": "bash scripts/release-public.sh --publish"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "deepseek",
    "agent",
    "harness",
    "dsh-plugin",
    "internal-urls",
    "conflict",
    "github",
    "pr",
    "issue"
  ]
}
