{
  "name": "@hy-sde-org/dsh-orchestration-policy",
  "version": "0.2.0-rc.2",
  "description": "Parallelize-by-default orchestration policy: config-driven fan-out rules, fail-closed task-isolation guard, review-gate posture resolution, and the `orchestration:policy` system-prompt section (firstmate dispatch-profile shape) \u2014 a standalone plugin for DeepSeek Harness.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run clean && pnpm run build"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hy-sde/dsh-orchestration-policy.git",
    "directory": "packages/orchestration-policy"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "deepseek",
    "agent",
    "harness",
    "dsh-plugin",
    "orchestration",
    "policy",
    "parallel",
    "fan-out",
    "isolation",
    "review-gate"
  ],
  "homepage": "https://github.com/hy-sde/dsh-orchestration-policy#readme",
  "bugs": {
    "url": "https://github.com/hy-sde/dsh-orchestration-policy/issues"
  }
}
